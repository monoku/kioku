    brain) if (( CURRENT == 3 )); then local -a sub; sub=('create:makes a brain on this machine with the name you give it, with no remote and no network; personal unless --tier says' 'clone:brings a brain that exists to this machine from any address, under the name it holds' 'sync:pulls and pushes a brain, or every brain, wherever you are' 'publish:pushes a brain that lives only on this machine to an empty repository at the address you give; its name stays' 'list:the brains this machine knows, and the chain of this folder' 'path:prints a brain'\''s folder' 'remove:takes a brain off this machine, never off the git host  deletes its clone and forgets it; refuses what would lose work unless --force' 'log:the writes of the chain'\''s brains since today, or since when you say' 'stats:what the writes of the chain'\''s brains add up to over a span, 30d unless you say  by verb, and how many saved pages were forgotten' 'sources:what the brains were filled from, with the version each page was written from' 'validate:checks a brain'\''s files against the format' 'lint:what to review  similar pages, quiet instincts, superseded decisions, and the rest' 'language:declares the language a brain'\''s pages are written in; the summary tells the agent' 'upgrade:raises a brain to the newest format, in one commit' 'refresh:rewrites the files the tool owns in a brain, or in every brain' 'conflicts:the changes kept aside after a conflict with the team'\''s, and how to resolve them'); _describe -t verbs 'kioku brain verb' sub; return; fi; verb="brain $words[3]" ;;
