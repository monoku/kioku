    plugin) if (( CURRENT == 3 )); then compadd claude-code claude; return; fi; if (( CURRENT == 4 )); then compadd install uninstall; return; fi; _arguments '--dry-run[dry run]' '--json[answer in JSON]'; return ;;
    help) if (( CURRENT == 3 )); then _describe -t verbs 'kioku verb' top; return; fi; if (( CURRENT == 4 )); then case $words[3] in page) local -a sub; sub=('search:searches the brains of this folder, by meaning and by text' 'list:the pages, 20 at a time, with their fields' 'show:one page, with its body, its links and its history' 'save:writes a page, or answers the similar pages it found instead' 'update:rewrites a page'\''s body, or one section, keeping its history' 'supersede:writes a new decision and marks the old one as replaced' 'forget:deletes a page; git keeps it' 'confirm:records that a page is still true' 'retire:marks a page as not current, kept as history' 'rename:gives a page a new title; links follow' 'move:moves a page to another namespace of its brain; its id stays and links follow' 'link:links two related pages, each under the other'\''s See also' 'promote:writes a page again in a more shared brain and retires the original' 'evolve:lists the instincts ready to become Skills, or converts one'); _describe -t verbs 'kioku page verb' sub ;; brain) local -a sub; sub=('create:makes a brain on this machine with the name you give it, with no remote and no network; personal unless --tier says' 'clone:brings a brain that exists to this machine from any address, under the name it holds' 'sync:pulls and pushes a brain, or every brain, wherever you are' 'publish:pushes a brain that lives only on this machine to an empty repository at the address you give; its name stays' 'list:the brains this machine knows, and the chain of this folder' 'path:prints a brain'\''s folder' 'remove:takes a brain off this machine, never off the git host  deletes its clone and forgets it; refuses what would lose work unless --force' 'log:the writes of the chain'\''s brains since today, or since when you say' 'stats:what the writes of the chain'\''s brains add up to over a span, 30d unless you say  by verb, and how many saved pages were forgotten' 'sources:what the brains were filled from, with the version each page was written from' 'validate:checks a brain'\''s files against the format' 'lint:what to review  similar pages, quiet instincts, superseded decisions, and the rest' 'language:declares the language a brain'\''s pages are written in; the summary tells the agent' 'upgrade:raises a brain to the newest format, in one commit' 'refresh:rewrites the files the tool owns in a brain, or in every brain' 'conflicts:the changes kept aside after a conflict with the team'\''s, and how to resolve them'); _describe -t verbs 'kioku brain verb' sub ;; namespace) local -a sub; sub=('list:the namespaces of the brains of this folder, with the pages in each' 'add:declares a namespace, or one under another, and writes its index with what it is for' 'describe:says what a namespace is for, in the paragraph under its index'\''s title' 'rename:gives a namespace another path, with everything under it; its folder, its pages and the links into it follow'); _describe -t verbs 'kioku namespace verb' sub ;; plugin) compadd claude-code claude ;; esac; return; fi; if (( CURRENT == 5 )) && [[ $words[3] == plugin ]]; then compadd install uninstall; fi; return ;;
  esac
