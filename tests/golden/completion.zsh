#compdef kioku
# Completion of kioku for zsh, generated by kioku 0.0.0-dev (kioku completion zsh).
_kioku_brains() { local -a b; b=(${(f)"$(kioku brain list --json 2>/dev/null | grep -o '"name":"[^"]*"' | cut -d'"' -f4 | sort -u)"}); compadd -a b }
_kioku_keys() { local -a k; k=(${(f)"$(kioku config --json 2>/dev/null | grep -o '"key":"[^"]*"' | cut -d'"' -f4)"}); compadd -a k }
_kioku_targets() { _kioku_brains; compadd personal project team }
