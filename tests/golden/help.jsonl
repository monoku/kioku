$ kioku help
{"verbs":[{"verb":"setup","usage":["kioku setup [--shell fish|zsh|bash|all] [--no-model]"],"does":"once per machine: the configuration, kioku on your PATH, your shell's completion, the search model; no brain"},{"verb":"doctor","usage":["kioku doctor"],"does":"checks the machine and says how to fix what is missing"},{"verb":"update","usage":["kioku update [<version>] [--check] [--dry-run]"],"does":"installs the latest release, or the one named, rewrites the agent integration and refreshes the brains"},{"verb":"completion","usage":["kioku completion fish|zsh|bash"],"does":"prints your shell's completion script, which setup makes the shell source"},{"verb":"plugin claude-code install","usage":["kioku plugin claude-code install [--dry-run]"],"does":"adds Claude Code's integration as a plugin, with Claude Code's own commands; asks first"},{"verb":"plugin claude-code uninstall","usage":["kioku plugin claude-code uninstall [--dry-run]"],"does":"removes that plugin and its marketplace"},{"verb":"config","usage":["kioku config","kioku config get <key>","kioku config set <key> <value>","kioku config unset <key>"],"does":"lists, reads and sets the machine's preferences, the owners it trusts and its team"},{"verb":"init","usage":["kioku init [<brain>]"],"does":"links a project folder to its project brain, cloned from an address or made by name; alone, accepts and clones what its kioku.yaml names"},{"verb":"sync","usage":["kioku sync [--cwd <dir>] [--background]"],"does":"pulls the brains of this folder's chain, pushes what is pending, updates the index"},{"verb":"brain create","usage":["kioku brain create <owner>/<repo> [--tier personal|project|team] [--language <tag>]"],"does":"makes a brain on this machine with the name you give it, with no remote and no network; personal unless --tier says"},{"verb":"brain clone","usage":["kioku brain clone <address>"],"does":"brings a brain that exists to this machine from any address, under the name it holds"},{"verb":"brain sync","usage":["kioku brain sync <brain>","kioku brain sync --all"],"does":"pulls and pushes a brain, or every brain, wherever you are"},{"verb":"brain publish","usage":["kioku brain publish <brain> --remote <address>"],"does":"pushes a brain that lives only on this machine to an empty repository at the address you give; its name stays"},{"verb":"brain list","usage":["kioku brain list"],"does":"the brains this machine knows, and the chain of this folder"},{"verb":"brain path","usage":["kioku brain path <brain>"],"does":"prints a brain's folder"},{"verb":"brain remove","usage":["kioku brain remove <brain> [--force] [--dry-run]"],"does":"takes a brain off this machine, never off the git host: deletes its clone and forgets it; refuses what would lose work unless --force"},{"verb":"brain log","usage":["kioku brain log [--since <when>] [--brain <b>] [--limit <n> [--offset <n>]]"],"does":"the writes of the chain's brains since today, or since when you say"},{"verb":"brain stats","usage":["kioku brain stats [--since <when>] [--brain <b>]"],"does":"what the writes of the chain's brains add up to over a span, 30d unless you say: by verb, and how many saved pages were forgotten"},{"verb":"brain sources","usage":["kioku brain sources [<source>] [--brain <b>] [--all]"],"does":"what the brains were filled from, with the version each page was written from"},{"verb":"brain validate","usage":["kioku brain validate [<brain>]"],"does":"checks a brain's files against the format"},{"verb":"brain lint","usage":["kioku brain lint [<brain>] [--limit <n>]"],"does":"what to review: similar pages, quiet instincts, superseded decisions, and the rest"},{"verb":"brain language","usage":["kioku brain language <tag> --brain <b>"],"does":"declares the language a brain's pages are written in; the summary tells the agent"},{"verb":"brain upgrade","usage":["kioku brain upgrade <brain>"],"does":"raises a brain to the newest format, in one commit"},{"verb":"brain refresh","usage":["kioku brain refresh [<brain>] [--all]"],"does":"rewrites the files the tool owns in a brain, or in every brain"},{"verb":"brain conflicts","usage":["kioku brain conflicts [<brain>] [--branch <b> [--page <path>]] [--open <b>] [--resolve <b>]"],"does":"the changes kept aside after a conflict with the team's, and how to resolve them"},{"verb":"page search","usage":["kioku page search <words> [--brain <b>] [--limit <n>] [--include-retired]"],"does":"searches the brains of this folder, by meaning and by text"},{"verb":"page list","usage":["kioku page list [--brain <b>] [--kind <k>] [--namespace <ns>] [--limit <n> [--offset <n>]] [--fields <a,b>] [--count]"],"does":"the pages, 20 at a time, with their fields"},{"verb":"page show","usage":["kioku page show <path> [--brain <b>] [--section <name> | --outline | --head <n>]"],"does":"one page, with its body, its links and its history"},{"verb":"page save","usage":["kioku page save --brain <b> --kind <k> --title <t> --source <s> [--sub <decision|playbook|context|instinct>]","           [--evidence <q>] [--summary <s>] [--aliases <a,b>] [--namespace <ns>]","           [--stale-after <date>] [--source-version <v>] [--create [--see-also <paths>]] < body"],"does":"writes a page, or answers the similar pages it found instead"},{"verb":"page update","usage":["kioku page update <path> [--brain <b>] [--section <name>] [--evidence <line> --source <s>]","             [--note <line>] [--summary <s>] [--aliases <a,b>] [--stale-after <date>|none]","             [--source-version <v>|none] < body"],"does":"rewrites a page's body, or one section, keeping its history"},{"verb":"page supersede","usage":["kioku page supersede <old path> [--brain <b>] --title <t> --source <s> [--evidence <q>]","                [--summary <s>] [--aliases <a,b>] [--namespace <ns>] [--stale-after <date>]","                [--source-version <v>] < body"],"does":"writes a new decision and marks the old one as replaced"},{"verb":"page forget","usage":["kioku page forget <path> [--brain <b>]"],"does":"deletes a page; git keeps it"},{"verb":"page confirm","usage":["kioku page confirm <path> [--brain <b>] [--note <line>]"],"does":"records that a page is still true"},{"verb":"page retire","usage":["kioku page retire <path> [--brain <b>] [--reason <line>] [--undo]"],"does":"marks a page as not current, kept as history"},{"verb":"page rename","usage":["kioku page rename <path> --title <new title> [--brain <b>]"],"does":"gives a page a new title; links follow"},{"verb":"page move","usage":["kioku page move <path> --namespace <ns> [--brain <b>]"],"does":"moves a page to another namespace of its brain; its id stays and links follow"},{"verb":"page link","usage":["kioku page link <path> <path> [--brain <b>] [--type contradicts|qualifies]"],"does":"links two related pages, each under the other's See also"},{"verb":"page promote","usage":["kioku page promote <path> --to <brain | tier> [--brain <b>] [--title <t>] [--summary <s>]","              [--aliases <a,b>] [--namespace <ns>] [--evidence <q>] [--create]","              [--keep | --forget] < body"],"does":"writes a page again in a more shared brain and retires the original"},{"verb":"page evolve","usage":["kioku page evolve [<instinct path> [--to skill|rule|playbook]] [--brain <b>]"],"does":"lists the instincts ready to become Skills, or converts one"},{"verb":"namespace list","usage":["kioku namespace list [--brain <b>]"],"does":"the namespaces of the brains of this folder, with the pages in each"},{"verb":"namespace add","usage":["kioku namespace add <path> --summary <text> --brain <b>"],"does":"declares a namespace, or one under another, and writes its index with what it is for"},{"verb":"namespace describe","usage":["kioku namespace describe <path> --summary <text> [--brain <b>]"],"does":"says what a namespace is for, in the paragraph under its index's title"},{"verb":"namespace rename","usage":["kioku namespace rename <from> <to> [--brain <b>] [--dry-run]"],"does":"gives a namespace another path, with everything under it; its folder, its pages and the links into it follow"},{"verb":"hook","usage":["kioku hook session-start|session-start-holds|user-prompt-submit|pre-compact|subagent-start|pre-tool-use|post-tool-use [--host claude-code]"],"does":"what the plugin's hooks call"}]}
